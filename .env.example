# ─── APP ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ─── JWT ────────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# ─── MONGODB ────────────────────────────────────────────────────────────────────
# Local (Docker)
MONGO_URI=mongodb://localhost:27017/student-scheduler
# MongoDB Atlas (producción / OnRender)
# MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/student-scheduler

# ─── REDIS ──────────────────────────────────────────────────────────────────────
# Local (Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Upstash (producción / OnRender)
# REDIS_URL=rediss://default:password@endpoint.upstash.io:6380

# ─── FIREBASE FCM ───────────────────────────────────────────────────────────────
# Descarga el archivo serviceAccountKey.json desde Firebase Console
# y coloca el path aquí, o pega el JSON como string
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# ─── BCRYPT ─────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=10
